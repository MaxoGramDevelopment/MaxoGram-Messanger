rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;

        match /chunks/{chunkId} {
          allow read, write: if true;
        }
      }

      match /call/{callId} {
        allow read, write: if true;
      }

      match /voice_channel/{docId} {
        allow read, write: if true;
      }

      match /voice_participants/{participantId} {
        allow read, write: if true;
      }

      match /audio_stream/{docId} {
        allow read, write: if true;
      }
    }
  }
}
